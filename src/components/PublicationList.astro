---
import { authorRuns, link, locator, toBibTeX, type Publication } from '../lib/bibtex';
import { url } from '../utils/paths';

interface Props {
	items: Publication[];
	/** Show the year in a left column (off when the list sits under a year heading). */
	showYear?: boolean;
	/** Show a "Cite" box with the BibTeX entry. */
	cite?: boolean;
	/** Project id -> short name, to label papers that relate to a project page. */
	projects?: Record<string, string>;
}
const { items, showYear = true, cite = false, projects = {} } = Astro.props;
const venueTail = (p: Publication) => (locator(p) ? `, ${locator(p)}` : '') + (p.note ? ` · ${p.note}` : '');
---

<ol class:list={['pub-list', { 'pub-list--plain': !showYear }]}>
	{
		items.map((p) => (
			<li class="pub">
				{showYear && <span class="pub__year">{p.year}</span>}
				<div class="pub__body">
					<p class="pub__title">{link(p) ? <a href={link(p)}>{p.title}</a> : p.title}</p>
					<p class="pub__authors">{authorRuns(p).map((run) => (run.owner ? <strong>{run.text}</strong> : run.text))}</p>
					<p class="pub__venue"><em>{p.journal}</em>{venueTail(p)}</p>
					{(cite || (p.project && projects[p.project])) && (
						<div class="pub__meta">
							{p.project && projects[p.project] && (
								<a class="tag" href={url(`/research/${p.project}/`)}>{projects[p.project]}</a>
							)}
							{cite && (
								<details class="cite">
									<summary>Cite</summary>
									<pre tabindex="0"><code>{toBibTeX(p)}</code></pre>
								</details>
							)}
						</div>
					)}
				</div>
			</li>
		))
	}
</ol>
