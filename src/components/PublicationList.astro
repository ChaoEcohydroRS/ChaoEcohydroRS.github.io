---
import { link, locator, type Publication } from '../lib/bibtex';

interface Props {
	items: Publication[];
}
const { items } = Astro.props;

/** Author list as text runs, so no stray spaces appear before commas. */
const authorRuns = (p: Publication) =>
	p.authors.map((a, i) => ({
		text: `${a.last}, ${a.first}`,
		owner: a.isOwner,
		after: i < p.authors.length - 1 ? ', ' : p.etAl ? ', et al.' : '',
	}));
const venueTail = (p: Publication) => (locator(p) ? `, ${locator(p)}` : '') + (p.note ? ` · ${p.note}` : '');
---

<ol class="pub-list">
	{
		items.map((p) => (
			<li class="pub">
				<span class="pub__year">{p.year}</span>
				<div class="pub__body">
					<p class="pub__title">{link(p) ? <a href={link(p)}>{p.title}</a> : p.title}</p>
					<p class="pub__authors">{authorRuns(p).map((run) => (run.owner ? <><strong>{run.text}</strong>{run.after}</> : <>{run.text}{run.after}</>))}</p>
					<p class="pub__venue"><em>{p.journal}</em>{venueTail(p)}</p>
				</div>
			</li>
		))
	}
</ol>
