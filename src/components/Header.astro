---
import { NAV, SITE } from '../consts';
import { url } from '../utils/paths';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const here = Astro.url.pathname.slice(base.length) || '/';
const isCurrent = (href: string) => !href.includes('#') && href !== '/' && here.startsWith(href);
---

<header class="site-header">
	<div class="wrap site-header__inner">
		<a class="site-header__name" href={url('/')}>{SITE.name}</a>
		<nav aria-label="Main">
			<ul class="site-nav">
				{
					NAV.map((item) => (
						<li>
							<a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
