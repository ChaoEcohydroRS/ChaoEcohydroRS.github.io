---
import { CONTACT, PROFILES, SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap site-footer__inner">
		<p>
			{SITE.name} · {SITE.department}, {SITE.institution}
		</p>
		<ul class="inline-list">
			<li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
			{PROFILES.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
		</ul>
		<p class="site-footer__note">© {year} {SITE.name}. The homepage figure is a schematic and does not show measured data.</p>
	</div>
</footer>
