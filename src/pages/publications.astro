---
import { getCollection } from 'astro:content';
import PublicationList from '../components/PublicationList.astro';
import { PROFILES } from '../consts';
import Base from '../layouts/Base.astro';
import { publications } from '../lib/bibtex';

const scholar = PROFILES.find((p) => p.label === 'Google Scholar');
const years = [...new Set(publications.map((p) => p.year))];
const projects = Object.fromEntries((await getCollection('projects')).map((p) => [p.id, p.data.short]));
---

<Base title="Publications" description="Peer-reviewed publications and preprints by Chao Wang.">
	<div class="wrap">
		<header class="page-head">
			<h1>Publications</h1>
			<p class="lede">
				All {publications.length} papers, newest first. My name is in bold.
				{scholar && <>Citation counts are on <a href={scholar.href}>Google Scholar</a>.</>}
			</p>
		</header>

		<nav class="year-index" aria-label="Jump to year">
			<ul>
				{years.map((year) => <li><a href={`#y${year}`}>{year}</a></li>)}
			</ul>
		</nav>

		{
			years.map((year) => (
				<section class="year-group" id={`y${year}`} aria-labelledby={`y${year}-title`}>
					<h2 id={`y${year}-title`}>{year}</h2>
					<PublicationList items={publications.filter((p) => p.year === year)} showYear={false} cite projects={projects} />
				</section>
			))
		}
	</div>
</Base>
