---
import PublicationList from '../components/PublicationList.astro';
import { PROFILES } from '../consts';
import Base from '../layouts/Base.astro';
import { publications } from '../lib/bibtex';

const scholar = PROFILES.find((p) => p.label === 'Google Scholar');
---

<Base title="Publications" description="Selected peer-reviewed publications and preprints by Chao Wang.">
	<div class="wrap">
		<header class="page-head">
			<h1>Publications</h1>
			<p class="lede">
				Selected papers from more than 30 peer-reviewed articles.
				{scholar && <>The full list is on <a href={scholar.href}>Google Scholar</a>.</>}
			</p>
		</header>
		<section class="section" aria-label="Selected publications">
			<PublicationList items={publications} />
		</section>
	</div>
</Base>
