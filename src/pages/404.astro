---
import Base from '../layouts/Base.astro';
import { url } from '../utils/paths';
---

<Base title="Page not found">
	<div class="wrap">
		<header class="page-head">
			<h1>Page not found</h1>
			<p class="lede">
				The page you asked for does not exist. Try the <a href={url('/')}>home page</a>, <a
					href={url('/research/')}>Research</a
				>, or <a href={url('/publications/')}>Publications</a>.
			</p>
		</header>
	</div>
</Base>
