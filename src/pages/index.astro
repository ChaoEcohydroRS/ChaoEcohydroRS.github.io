---
import { getCollection, getEntry, render } from 'astro:content';
import PublicationList from '../components/PublicationList.astro';
import TerrainFigure from '../components/TerrainFigure.astro';
import { CONTACT, CV_PDF, PROFILES, SITE } from '../consts';
import Base from '../layouts/Base.astro';
import { publications } from '../lib/bibtex';
import { cvPdfExists } from '../lib/cv';
import { url } from '../utils/paths';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projectHref = (id: string) => url(`/research/${id}/`);
const [biomass, water] = projects;
const future = await getEntry('pages', 'future');
const { Content: Future } = await render(future!);
const featured = publications.filter((p) => p.home);
---

<Base>
	<div class="wrap">
		<section class="hero" aria-labelledby="name">
			<div class="hero__text">
				<h1 id="name">{SITE.name}</h1>
				<p class="hero__role">
					<strong>{SITE.role}</strong>
					{SITE.department}<br />
					{SITE.institution}
				</p>
				<p class="hero__lead">{SITE.lead}</p>
				<ul class="hero__links">
					<li><a class="button" href={url('/research/')}>Research</a></li>
					<li><a class="button button--ghost" href={url('/publications/')}>Publications</a></li>
					<li>
						{
							cvPdfExists ? (
								<a class="button button--ghost" href={url(CV_PDF)} download>
									CV (PDF)
								</a>
							) : (
								<a class="button button--ghost" href={url('/cv/')}>
									CV
								</a>
							)
						}
					</li>
				</ul>
			</div>
			<TerrainFigure biomassHref={projectHref(biomass.id)} waterHref={projectHref(water.id)} />
		</section>

		<section class="section" aria-labelledby="projects">
			<div class="section__head">
				<h2 id="projects">Current projects</h2>
				<a class="section__more" href={url('/research/')}>All research</a>
			</div>
			<ul class="cards">
				{
					projects.map((project) => (
						<li>
							<article class="card">
								<p class="card__kicker">{project.data.short}</p>
								<h3>{project.data.title}</h3>
								<p>{project.data.summary}</p>
								<p>
									<a href={projectHref(project.id)}>Read about this project</a>
								</p>
							</article>
						</li>
					))
				}
			</ul>
		</section>

		<section class="section" aria-labelledby="pubs">
			<div class="section__head">
				<h2 id="pubs">Selected publications</h2>
				<a class="section__more" href={url('/publications/')}>All publications</a>
			</div>
			<PublicationList items={featured} />
		</section>

		<section class="section" aria-labelledby="future">
			<div class="section__head">
				<h2 id="future">Future research</h2>
			</div>
			<div class="prose">
				<Future />
			</div>
		</section>

		<section class="section" aria-labelledby="teaching">
			<div class="section__head">
				<h2 id="teaching">Teaching and mentoring</h2>
				<a class="section__more" href={url('/teaching/')}>Courses and experience</a>
			</div>
			<div class="prose">
				<p>
					I teach geospatial data science by starting from a real task and working through data, method,
					validation, and communication. I am prepared to teach spatial data science, GIS, and remote sensing, and
					to develop courses in GeoAI and high-performance geospatial computing.
				</p>
				<p>
					At UNC I currently co-advise one MS student, advise three undergraduate researchers, and serve on two PhD
					committees. Two former mentees are authors of 2026 papers in <em>Landscape Ecology</em>.
				</p>
			</div>
		</section>

		<section class="section contact" id="contact" aria-labelledby="contact-title">
			<div class="section__head">
				<h2 id="contact-title">Contact</h2>
			</div>
			<div class="two-col">
				<address>
					<p>
						<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
					</p>
					<p>
						{SITE.department}<br />
						{SITE.institution}<br />
						{CONTACT.addressLines.map((line) => <>{line}<br /></>)}
					</p>
				</address>
				<ul class="link-list">
					{PROFILES.map((profile) => <li><a href={profile.href}>{profile.label}</a></li>)}
					<li><a href={url('/cv/')}>Curriculum vitae</a></li>
				</ul>
			</div>
		</section>
	</div>
</Base>
